<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <LinearLayout
        android:padding="@dimen/_20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:src="@drawable/weather"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_150dp"
            android:layout_marginTop="@dimen/_10dp" />

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10dp">

            <TextView
                android:id="@+id/tvCityName"
                android:textColor="@color/splash_text_white"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Zagreb" />

            <ImageView
                android:id="@+id/ivFavorite"
                android:src="@drawable/red_flag"
                android:layout_marginStart="@dimen/_10dp"
                android:layout_width="@dimen/_30dp"
                android:layout_height="@dimen/_30dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvTemperature"
            android:textColor="@color/nav_item_selected_text"
            android:textSize="56sp"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/_10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="18.5°C" />

        <TextView
            android:id="@+id/tvDescription"
            android:textColor="@color/splash_subtitle"
            android:textSize="18sp"
            android:layout_marginTop="@dimen/_5dp"
            android:layout_marginBottom="@dimen/_20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="scattered clouds" />

        <androidx.cardview.widget.CardView
            app:cardBackgroundColor="@color/nav_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10dp">

            <LinearLayout
                android:padding="@dimen/_16dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/_12dp">

                    <TextView
                        android:text="@string/osje_aj"
                        android:textColor="@color/nav_item_default_text"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvFeelsLike"
                        android:textColor="@color/splash_text_white"
                        android:textStyle="bold"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:layout_height="wrap_content"
                        tools:text="17.2°C" />

                </LinearLayout>

                <View
                    android:background="@color/nav_item_default_text"
                    android:alpha="0.2"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/_12dp"
                    android:paddingBottom="@dimen/_12dp">

                    <TextView
                        android:text="Vlažnost:"
                        android:textColor="@color/nav_item_default_text"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvHumidity"
                        android:textColor="@color/splash_text_white"
                        android:textStyle="bold"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:layout_height="wrap_content"
                        tools:text="65%" />

                </LinearLayout>

                <View
                    android:background="@color/nav_item_default_text"
                    android:alpha="0.2"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/_12dp"
                    android:paddingBottom="@dimen/_12dp">

                    <TextView
                        android:text="Tlak:"
                        android:textColor="@color/nav_item_default_text"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvPressure"
                        android:textColor="@color/splash_text_white"
                        android:textStyle="bold"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:layout_height="wrap_content"
                        tools:text="1013 hPa" />

                </LinearLayout>

                <View
                    android:background="@color/nav_item_default_text"
                    android:alpha="0.2"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/_12dp">

                    <TextView
                        android:text="Vjetar:"
                        android:textColor="@color/nav_item_default_text"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvWind"
                        android:textColor="@color/splash_text_white"
                        android:textStyle="bold"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:layout_height="wrap_content"
                        tools:text="3.5 m/s" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            app:cardBackgroundColor="@color/nav_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16dp">

            <LinearLayout
                android:padding="@dimen/_16dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="O ovoj lokaciji"
                    android:textColor="@color/splash_text_white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/_10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Podaci o vremenu preuzeti su u stvarnom vremenu putem OpenWeatherMap API-ja. Temperatura, vlažnost, tlak i brzina vjetra ažuriraju se prilikom svakog dohvata podataka za odabranu lokaciju."
                    android:textColor="@color/nav_item_default_text"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>